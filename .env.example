# All optional. See DEPLOYMENT.md for details.

# Behind a reverse proxy / Cloud Run: trust one proxy hop so rate limits use the client IP.
# TRUST_PROXY=1

# Open-Meteo: weighted calls per UTC day for this server, the part reserved for scheduled jobs,
# per-minute pacing, and an optional commercial key (switches to the customer-* hosts).
# OPEN_METEO_DAILY_BUDGET=5000
# OPEN_METEO_RESERVE=1500
# OPEN_METEO_PER_MINUTE=300
# OPEN_METEO_API_KEY=

# Daily precomputed outlooks and the live track record (default on when NODE_ENV=production).
# PRECOMPUTE=1
# PRECOMPUTE_ALLOWANCE=1500
# TRACK_RECORD=1

# Globe GFS field cache in minutes (≈144 weighted calls per refresh).
# GLOBE_TTL_MIN=180
